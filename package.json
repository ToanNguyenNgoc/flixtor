{
  "name": "flixtor",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build:apk": "cd android && ./gradlew clean && ./gradlew assembleRelease",
    "build:aab": "cd android && ./gradlew clean && ./gradlew bundleRelease",
    "clean": "rm -rf yarn.lock && rm -rf node_modules && rm -rf ios/Pods && rm ios/Podfile.lock",
    "clean:android": "rm -rf android/app/.cxx && rm -rf android/app/build",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "install:ios": "bundle install && cd ios && pod cache clean --all && bundle exec pod install",
    "reset-cache": "npx react-native start --reset-cache",
    "assets": "node scripts/gen-svg.js && node scripts/gen-svg.mjs && node scripts/gen-image.js && node scripts/gen-json.js",
    "postinstall": "patch-package",
    "signingReport": "cd android && ./gradlew signingReport"
  },
